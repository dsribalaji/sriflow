#!/usr/bin/env bash
# sriflow-timeline — fallback implementation
# Logs timeline events to ~/.sriflow/projects/<slug>/timeline.jsonl

ACTION="${1:-}"
PROJECT_DIR="${SRIFLOW_PROJECT_DIR:-$(pwd)}"
SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PROJECT_DIR")")
FILE="$HOME/.sriflow/projects/$SLUG/timeline.jsonl"
mkdir -p "$(dirname "$FILE")"

case "$ACTION" in
  log)
    echo "$2" >> "$FILE"
    ;;
  *)
    echo "Usage: sriflow-timeline log '<json>'"
    exit 1
    ;;
esac
