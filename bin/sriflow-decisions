#!/usr/bin/env bash
# sriflow-decisions — fallback implementation

ACTION="${1:-}"
PROJECT_DIR="${SRIFLOW_PROJECT_DIR:-$(pwd)}"
SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PROJECT_DIR")")
FILE="$HOME/.sriflow/projects/$SLUG/decisions.jsonl"

case "$ACTION" in
  count)
    [ -f "$FILE" ] && wc -l < "$FILE" || echo "0"
    ;;
  add)
    mkdir -p "$(dirname "$FILE")"
    cat >> "$FILE"
    ;;
  *)
    [ -f "$FILE" ] && cat "$FILE" || echo ""
    ;;
esac
