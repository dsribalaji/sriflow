#!/usr/bin/env bash
# sriflow-config — fallback implementation
# Reads config from SRIFLOW_CONFIG_FILE or ~/.sriflow/config.yaml
# Falls back to defaults when the real sriflow-config binary is not installed.

CONFIG_FILE="${SRIFLOW_CONFIG_FILE:-$HOME/.sriflow/config.yaml}"
KEY="${1:-}"
DEFAULT="${2:-}"

if [ -f "$CONFIG_FILE" ] && command -v yq >/dev/null 2>&1; then
  yq -r ".${KEY} // \"$DEFAULT\"" "$CONFIG_FILE" 2>/dev/null && exit 0
fi

# Fallback defaults
case "$KEY" in
  proactive) echo "true" ;;
  telemetry) echo "off" ;;
  explain_level) echo "default" ;;
  *) echo "$DEFAULT" ;;
esac
exit 0
