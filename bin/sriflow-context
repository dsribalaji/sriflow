#!/usr/bin/env bash
# sriflow-context — fallback implementation
# Stores/retrieves session context from ~/.sriflow/projects/<slug>/context.json

ACTION="${1:-}"
PROJECT_DIR="${SRIFLOW_PROJECT_DIR:-$(pwd)}"
SLUG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || echo "$PROJECT_DIR")")
CTX_FILE="$HOME/.sriflow/projects/$SLUG/context.json"

case "$ACTION" in
  show)
    if [ -f "$CTX_FILE" ]; then
      cat "$CTX_FILE"
    else
      echo "{\"branch\":\"$(git branch --show-current 2>/dev/null || echo 'unknown')\"}"
    fi
    ;;
  save)
    mkdir -p "$(dirname "$CTX_FILE")"
    cat > "$CTX_FILE"
    ;;
  *)
    echo "Usage: sriflow-context show|save"
    exit 1
    ;;
esac
