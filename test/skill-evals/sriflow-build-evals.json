{
  "skill": "sriflow-build",
  "version": "2.0.0",
  "evals": [
    {
      "id": "build-01",
      "prompt": "Build a simple REST API endpoint for user registration",
      "expected_patterns": [
        "pre-build safety check OR Step 0",
        "context load OR PLAN.md",
        "existing code scan OR reuse",
        "trim ladder OR YAGNI",
        "self-check OR assert"
      ],
      "anti_patterns": [
        "skip Step 2",
        "write code before scanning",
        "add new dependency.*few lines"
      ],
      "tags": ["safety", "context", "reuse"]
    },
    {
      "id": "build-02",
      "prompt": "Implement a file upload feature with validation",
      "expected_patterns": [
        "Step 0.*destructive",
        "PLAN.md.*DESIGN.md",
        "existing.*upload",
        "one line OR one function",
        "security.*validation"
      ],
      "anti_patterns": [
        "new dependency.*upload",
        "skip safety check",
        "no self-check"
      ],
      "tags": ["safety", "security", "reuse"]
    }
  ]
}
