{
  "skill": "sriflow-code-review",
  "version": "2.0.0",
  "evals": [
    {
      "id": "review-01",
      "prompt": "Review this pull request for security issues",
      "expected_patterns": [
        "blocking.*security",
        "SQL injection OR parameterized",
        "XSS OR output encoding",
        "OWASP",
        "CODE_REVIEW.md"
      ],
      "anti_patterns": [
        "skip security lens",
        "no severity labels",
        "approve without findings"
      ],
      "tags": ["security", "severity", "report"]
    }
  ]
}
