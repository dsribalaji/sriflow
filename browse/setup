#!/usr/bin/env bash
# sriflow browse setup — build the browser daemon binary.
# Run from anywhere: it resolves the repo root (this script lives in browse/).
set -euo pipefail
umask 077  # owner-only files (0o600) / dirs (0o700)

BROWSE_DIR="$(cd "$(dirname "$0")" && pwd -P)"
ROOT_DIR="$(cd "$BROWSE_DIR/.." && pwd -P)"

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun is required but not installed." >&2
  echo "Install it with:" >&2
  echo "  curl -fsSL https://bun.sh/install | bash" >&2
  echo "then re-run: $BROWSE_DIR/setup" >&2
  exit 1
fi

echo "sriflow browse setup"
echo "===================="
echo "Repo:  $ROOT_DIR"
echo ""

# Dependencies (playwright, diff) live in the repo-root package.json.
echo "Installing dependencies..."
(cd "$ROOT_DIR" && bun install)

# Download the Chromium playwright drives.
echo "Installing Chromium..."
(cd "$ROOT_DIR" && bunx playwright install chromium) || \
  echo "WARN: 'playwright install chromium' failed — install it manually if the browser won't start." >&2

# Compile the daemon + copy the $B wrapper into dist/.
echo "Building daemon..."
(cd "$ROOT_DIR" && bun run build)

echo ""
echo "Setup complete. Binary: $BROWSE_DIR/dist/browse"
