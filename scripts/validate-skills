#!/usr/bin/env bash
# Validate all sriflow skills against the Agent Skills spec
# (with sriflow extended fields allowed)
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILLS_REF_DIR="$PROJECT_DIR/reference/agentskills-main/skills-ref"

if [ ! -d "$SKILLS_REF_DIR/.venv" ]; then
  echo "Setting up skills-ref environment..."
  cd "$SKILLS_REF_DIR" && uv sync --quiet 2>/dev/null
fi

cd "$PROJECT_DIR"
source "$SKILLS_REF_DIR/.venv/bin/activate"

exec python3 -c '
import sys
from pathlib import Path
from skills_ref.parser import find_skill_md, parse_frontmatter
# spec constants
MAX_NAME_LENGTH = 64
MAX_DESCRIPTION_LENGTH = 1024

ALLOWED_FIELDS = {
    "name", "description", "license", "allowed-tools", "metadata", "compatibility",
    "preamble-tier", "version", "category", "related",
    "triggers", "next-skill", "outputs", "gate", "prerequisite",
}

skills_dir = Path("skills")
total_errors = 0
skill_count = 0

for skill_dir in sorted(skills_dir.iterdir()):
    if not skill_dir.is_dir() or skill_dir.name.startswith("."):
        continue
    skill_count += 1
    errors = []

    skill_md = find_skill_md(skill_dir)
    if not skill_md:
        errors.append("Missing SKILL.md")
    else:
        content = skill_md.read_text()
        try:
            metadata, _ = parse_frontmatter(content)
        except Exception as e:
            errors.append(str(e))
            metadata = {}

        extra = set(metadata.keys()) - ALLOWED_FIELDS
        if extra:
            errors.append(f"unexpected fields: {sorted(extra)}")

        name = metadata.get("name", "")
        if not name:
            errors.append("missing required field: name")
        else:
            if name != name.lower():
                errors.append(f"name must be lowercase: \"{name}\"")
            if name.startswith("-") or name.endswith("-"):
                errors.append("name cannot start or end with hyphen")
            if "--" in name:
                errors.append("name cannot have consecutive hyphens")
            if skill_dir.name != name:
                errors.append(f"dir name \"{skill_dir.name}\" != name \"{name}\"")
            if len(name) > MAX_NAME_LENGTH:
                errors.append(f"name exceeds {MAX_NAME_LENGTH} chars ({len(name)})")

        desc = metadata.get("description", "")
        if not desc:
            errors.append("missing required field: description")

    if errors:
        total_errors += len(errors)
        for e in errors:
            print(f"  FAIL  {skill_dir.name}: {e}")
    else:
        print(f"  PASS  {skill_dir.name}")

if total_errors:
    print(f"\n{total_errors} validation error(s) across {skill_count} skills")
    sys.exit(1)
else:
    print(f"\nAll {skill_count} skills valid against Agent Skills spec (with sriflow extensions)")
'
